# Copy to .env and fill in real values before deploying.

# ─── REQUIRED IN PRODUCTION ──────────────────────────────────────────────
# App refuses to start if SECRET_KEY is the default AND ENVIRONMENT=production.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# PostgreSQL password used by docker-compose.
DB_PASSWORD=syncwatch

# ─── DEPLOYMENT ─────────────────────────────────────────────────────────
# Set to "production" to enforce SECRET_KEY.
ENVIRONMENT=development

# Comma-separated allow-list for REST CORS and WS Origin check.
# Include both localhost and 127.0.0.1 — browsers use whichever is typed
# into the address bar, and the Origin check is a string match.
CORS_ORIGINS=http://localhost:3000,http://localhost,http://127.0.0.1:3000,http://127.0.0.1

# ─── TOKEN LIFETIMES (optional; defaults shown) ─────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
WS_TICKET_EXPIRE_SECONDS=30

# ─── FRONTEND (optional; same-origin defaults work in dev via Vite proxy) ─
# Absolute URLs let the built frontend target a backend on a different host.
# VITE_API_URL=https://api.example.com
# VITE_WS_URL=wss://api.example.com/ws
